WEATHER_DB_HOST=localhost
WEATHER_DB_PORT=5433
WEATHER_DB_NAME=weather
WEATHER_DB_USER=weather
WEATHER_DB_PASSWORD=replace_with_a_local_password

# Airflow local development settings
AIRFLOW_WEB_PORT=8080
# Use a URL-safe password (letters and numbers) for the metadata connection URL.
AIRFLOW_DB_PASSWORD=replace_with_a_separate_local_password
# Generate a Fernet key: python -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
AIRFLOW_FERNET_KEY=replace_with_a_generated_fernet_key
# Generate a JWT secret: python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW_JWT_SECRET=replace_with_a_generated_jwt_secret
